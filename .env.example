# AI edits. Copy this to `.env`, add one key, restart the dev server. That is the whole setup.
#
#     cp .env.example .env
#     npm run dev
#
# There is nothing to configure in vite.config.ts. The plugin reads this file itself and offers
# every provider it finds a key for, so `editorOverlay()` with no options is enough.
#
# Keys stay on the dev server. The browser is told which providers exist and what they are
# called, never where they are or what the credential is. Note the absence of a VITE_ prefix on
# anything here: Vite inlines VITE_-prefixed variables into client bundles, which for a
# credential is the one outcome to avoid.
#
# `.env` is gitignored. This file is not, so keep it as a template and never paste a real key.

# ---------------------------------------------------------------------------
# Providers that need only a key
# ---------------------------------------------------------------------------
# The host and the API dialect are facts about the provider, so the variable name is enough.
# These are the names every other SDK and CLI uses, so one you already have works as it is.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=          # or GOOGLE_API_KEY
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# CEREBRAS_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=

# Set as many as you like. They all appear in the editor's provider list, and the first one
# found becomes the default.

# ---------------------------------------------------------------------------
# Any number of OpenAI-compatible endpoints
# ---------------------------------------------------------------------------
# For gateways, self-hosted servers, a work key beside a personal one — anything the list above
# does not name. Pick any NAME; the group is what ties the variables together, so there is no
# limit on how many you add.
#
# HEO_AI_<NAME>_API_KEY     required
# HEO_AI_<NAME>_BASE_URL    required — there is no default host for an endpoint nobody named
# HEO_AI_<NAME>_MODEL       optional — what the model field starts with
# HEO_AI_<NAME>_MODELS      optional — comma-separated allow-list, enforced on the server
# HEO_AI_<NAME>_LABEL       optional — the name shown in the editor
# HEO_AI_<NAME>_PROVIDER    optional — openai | anthropic | google | openai-compatible
#                                      (openai-compatible is the default)

# HEO_AI_WORK_API_KEY=
# HEO_AI_WORK_BASE_URL=https://gateway.internal/v1
# HEO_AI_WORK_LABEL=Work gateway
# HEO_AI_WORK_MODELS=llama-3.3-70b,qwen-2.5

# HEO_AI_OLLAMA_API_KEY=not-needed-but-required
# HEO_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# HEO_AI_OLLAMA_LABEL=Ollama

# ---------------------------------------------------------------------------
# Overriding one of the providers above
# ---------------------------------------------------------------------------
# The same suffixes work on a known provider, using its own name. One convention, not two.

# HEO_AI_ANTHROPIC_MODEL=claude-opus-4-5
# HEO_AI_OPENAI_MODELS=gpt-4o-mini,gpt-4o
