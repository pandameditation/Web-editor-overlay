{
  "name": "html-editor-overlay",
  "version": "2.0.0",
  "description": "An injectable, in-page visual editor overlay built from Lit web components. Edit any HTML page, then export the change set as a code-ready prompt.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/html-editor-overlay.js",
  "module": "./dist/html-editor-overlay.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/html-editor-overlay.js"
    },
    "./standalone": "./dist/html-editor-overlay.iife.js",
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:plugin && npm run types",
    "build:lib": "vite build",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:css": "node --experimental-strip-types test/css-patch.test.ts",
    "test:instrument": "node --experimental-strip-types test/instrument.test.ts",
    "test:prompt": "node scripts/run-node-test.mjs test/prompt.test.ts",
    "prompt": "node scripts/run-node-test.mjs test/prompt.test.ts --print",
    "test:endpoint": "node test/fs-endpoint.test.mjs",
    "check:opaque": "HEO_FILE_ACCESS=strict node scripts/browser-check.mjs test/opaque-origin.html 45000",
    "check:access": "HEO_FILE_ACCESS=strict node scripts/browser-check.mjs test/file-access.html 45000",
    "check:mirror": "HEO_FILE_ACCESS=strict node scripts/browser-check.mjs test/mirror.html 45000",
    "preview": "vite preview --config vite.demo.config.ts",
    "check": "npm run build:lib && npm run build:plugin && npm run test:css && npm run test:instrument && npm run test:prompt && npm run test:endpoint && node scripts/browser-check.mjs test/self-check.html 60000 && node scripts/browser-check.mjs test/writeback.html 60000 && node scripts/browser-check.mjs test/chrome-tracking.html 45000 && node scripts/browser-check.mjs test/script-tag.html 45000 && node scripts/browser-check.mjs test/script-tag-manual.html 45000 && npm run check:opaque && npm run check:access && npm run check:mirror && npm run check:provenance && npm run check:late && npm run check:advisory && npm run check:export && npm run check:plan && npm run check:htmlpatch && npm run check:cssrules && npm run check:shield && npm run check:sweepout && npm run check:token && npm run check:download && npm run check:paste && npm run check:dsscope && npm run check:bundle && npm run check:bundle:strict && npm run check:reveal && npm run check:links && npm run check:newtab && npm run check:textdrag && npm run check:edgescroll && npm run check:move && npm run check:pin && npm run check:blockseed && npm run check:seedblock && npm run check:savestatus && npm run check:patchfidelity && npm run check:searchfield && npm run check:dimensional && npm run check:popover",
    "check:plugin": "node scripts/browser-check.mjs http://localhost:5180/probe.html 40000",
    "check:provenance": "node scripts/browser-check.mjs test/provenance.html 45000",
    "check:late": "node scripts/browser-check.mjs test/late-mount.html 45000",
    "check:advisory": "node scripts/browser-check.mjs test/advisory.html 45000",
    "check:export": "node scripts/browser-check.mjs test/export.html 45000",
    "check:plan": "node scripts/browser-check.mjs test/plan-honesty.html 45000",
    "check:htmlpatch": "node scripts/browser-check.mjs test/html-patch.html 45000",
    "check:cssrules": "node scripts/browser-check.mjs test/css-rules.html 45000",
    "check:shield": "node scripts/browser-check.mjs test/shield.html 45000",
    "check:sweepout": "node scripts/browser-check.mjs test/text-sweep-out.html 45000",
    "check:token": "node scripts/browser-check.mjs test/token-target.html 45000",
    "check:download": "node scripts/browser-check.mjs test/download.html 45000",
    "check:bundle": "node scripts/browser-check.mjs test/bundle.html 45000",
    "check:bundle:strict": "HEO_FILE_ACCESS=strict node scripts/browser-check.mjs test/bundle.html 45000",
    "check:reveal": "node scripts/browser-check.mjs test/reveal.html 60000",
    "check:links": "node scripts/browser-check.mjs test/links.html 45000",
    "check:newtab": "node scripts/browser-check.mjs test/link-newtab.html 45000",
    "check:textdrag": "node scripts/browser-check.mjs test/text-drag.html 45000",
    "check:edgescroll": "node scripts/browser-check.mjs test/edge-scroll.html 150000",
    "check:paste": "node scripts/browser-check.mjs test/paste-html.html 45000",
    "check:dsscope": "node scripts/browser-check.mjs test/design-scope.html 45000",
    "check:move": "node scripts/browser-check.mjs test/transform-move.html 90000",
    "check:pin": "node scripts/browser-check.mjs test/position-pin.html 90000",
    "check:blockseed": "node scripts/browser-check.mjs test/block-roundtrip.html 60000",
    "check:seedblock": "node scripts/browser-check.mjs test/seed-block.html 45000",
    "check:savestatus": "node scripts/browser-check.mjs test/save-status.html 60000",
    "check:patchfidelity": "node scripts/browser-check.mjs test/patch-fidelity.html 60000",
    "check:dimensional": "node scripts/browser-check.mjs test/dimensional.html 60000",
    "check:searchfield": "node scripts/browser-check.mjs test/search-field.html 60000",
    "check:popover": "node scripts/browser-check.mjs test/popover-settle.html 60000",
    "check:firefox": "node scripts/firefox-check.mjs test/popover-settle.html 90000"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  },
  "keywords": [
    "lit",
    "web-components",
    "visual-editor",
    "overlay",
    "design-tokens",
    "vite-plugin"
  ],
  "optionalDependencies": {
    "@ast-grep/lang-bash": "^0.0.8",
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-dart": "^0.0.7",
    "@ast-grep/lang-elixir": "^0.0.7",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-haskell": "^0.0.7",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-kotlin": "^0.0.7",
    "@ast-grep/lang-lua": "^0.0.7",
    "@ast-grep/lang-php": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/lang-scala": "^0.0.7",
    "@ast-grep/lang-swift": "^0.0.8",
    "@ast-grep/napi": "^0.45.1"
  }
}
