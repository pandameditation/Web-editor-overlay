{
  "name": "html-editor-overlay",
  "version": "2.0.0",
  "description": "An injectable, in-page visual editor overlay built from Lit web components. Edit any HTML page, then export the change set as a code-ready prompt.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/html-editor-overlay.js",
  "module": "./dist/html-editor-overlay.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/html-editor-overlay.js"
    },
    "./standalone": "./dist/html-editor-overlay.iife.js",
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:plugin && npm run types",
    "build:lib": "vite build",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --config vite.demo.config.ts",
    "check": "npm run build:lib && node scripts/browser-check.mjs test/self-check.html 60000",
    "check:plugin": "node scripts/browser-check.mjs http://localhost:5180/probe.html 40000"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  },
  "keywords": [
    "lit",
    "web-components",
    "visual-editor",
    "overlay",
    "design-tokens",
    "vite-plugin"
  ]
}
